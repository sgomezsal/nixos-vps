{
  "name": "nixos-vps-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/hetzner"
  ],
  "scripts": {
    "build": "npm run build --workspace nixos-vps && npm run build --workspace nixos-vps-provider",
    "check": "npm run build && npm run check --workspaces --if-present",
    "test": "npm run build && npm run test --workspaces --if-present && node scripts/test-package.cjs",
    "test:preflight": "node scripts/test-preflight.cjs",
    "test:secrets": "node scripts/test-sops.cjs",
    "validate:clean": "node scripts/validate-clean.cjs",
    "pack:component": "npm pack --workspace nixos-vps --pack-destination /tmp",
    "release:prepare": "node scripts/release.cjs prepare",
    "release:verify": "node scripts/release.cjs verify",
    "test:provider": "node scripts/test-component-provider.cjs",
    "provider:prepare": "node scripts/provider-release.cjs prepare .provider-release",
    "provider:verify": "node scripts/provider-release.cjs verify .provider-release",
    "provider:candidate": "node scripts/provider-release.cjs candidate .provider-candidate",
    "provider:candidate:verify": "node scripts/provider-release.cjs verify-candidate .provider-candidate",
    "test:provider:public": "node scripts/test-provider-public.cjs"
  },
  "devDependencies": {
    "@actions/glob": "0.6.1",
    "@types/node": "^22",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
