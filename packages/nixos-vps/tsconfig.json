{
  "compilerOptions": {
    "strict": true, "target": "ES2020", "module": "commonjs",
    "moduleResolution": "node", "rootDir": "src", "outDir": "lib",
    "declaration": true, "sourceMap": true, "inlineSources": true, "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
