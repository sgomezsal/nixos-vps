{
  "name": "nixos-vps-provider",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-language Pulumi component provider for nixos-vps",
  "license": "MIT",
  "main": "lib/provider.js",
  "types": "lib/provider.d.ts",
  "bin": { "pulumi-resource-nixos-vps": "scripts/provider.cjs" },
  "files": ["lib", "scripts", "schema.json", "distribution.json", "runtime/package.json", "runtime/package-lock.json", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.cjs"
  },
  "engines": { "node": ">=22" },
  "dependencies": { "@pulumi/pulumi": "3.272.0", "nixos-vps": "0.1.2" }
}
